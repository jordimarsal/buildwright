# --- buildwright: role -> model (registry ids; defaults to the package's models.yaml) ---
# BW_MODELS_FILE=./models.yaml   # project-local registry (optional)
BW_ROLE_PLANNER=local/qwen3
BW_ROLE_WORKER=remote/gpt-4o-mini
BW_ROLE_REVIEWER=local/qwen3

# --- provider keys (only the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LITELLM_API_KEY=

# --- Langfuse (optional: without keys, tracing is disabled) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
